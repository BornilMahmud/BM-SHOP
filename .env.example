# Frontend (exposed to browser via Vite — safe for public Firebase + Supabase anon)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (do NOT prefix with VITE_ — never expose to browser)
# Used by server/ for payment gateway + privileged Supabase writes.
SUPABASE_SERVICE_ROLE_KEY=

NAGAD_APP_ENV=development
NAGAD_APP_MERCHANT_ID=
NAGAD_APP_MERCHANT_PRIVATE_KEY=
NAGAD_APP_MERCHANT_PG_PUBLIC_KEY=
NAGAD_APP_CALLBACK_URL=https://example.com/api/nagad/callback
